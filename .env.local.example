# ─────────────────────────────────────────────────────────────────────────────
# ATELIER — Virtual Wardrobe & AI Stylist
# Copy this file to `.env.local` and fill in the FREE-tier credentials below.
# NEVER commit your real `.env.local` to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas (M0 free cluster) ──────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/atelier_wardrobe?retryWrites=true&w=majority"

# ── Cloudinary (free plan) ───────────────────────────────────────────────────
# Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Google Gemini (free tier via Google AI Studio) ───────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key"

# Optional model override (free-tier flash model):
# GEMINI_MODEL="gemini-2.5-flash"

# ── Hugging Face (free read token) ───────────────────────────────────────────
# https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_read_token"

# Optional space override:
# HF_VTON_SPACE="yisol/IDM-VTON"
